<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainConstraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/leaderboardsbg"
    tools:context=".MainActivity">

    <!-- TOP BAR SECTION -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="1.0">

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/imageBackArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_back"
            app:tint="@android:color/white" />

        <!-- "Profile" Title -->
        <TextView
            android:id="@+id/textProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Profile"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Push everything else to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Coin Layout (shows textCoinValue + coin icon) -->
        <LinearLayout
            android:id="@+id/coinLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <!-- textCoinValue: used to display the user’s coin/points -->
            <TextView
                android:id="@+id/textCoinValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <!-- imageCoinIcon: clickable coin icon to open the shop -->
            <ImageView
                android:id="@+id/imageCoinIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/coin"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- NEW ICONS ON LEFT LAYOUT (below top bar) -->
    <LinearLayout
        android:id="@+id/iconsOnLeftLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="-4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/topBarLayout"
        app:layout_constraintStart_toStartOf="parent">

        <!-- New Icon Below the Back Arrow / Top Bar -->
        <FrameLayout
            android:id="@+id/newIconLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imageNewIconCircle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/shopiconcircle" />

            <ImageView
                android:id="@+id/imageNewIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/shopicon" />
        </FrameLayout>
    </LinearLayout>

    <!-- NOTIFICATION, GIFT, SETTINGS ICONS ON RIGHT -->
    <LinearLayout
        android:id="@+id/iconsOnRightLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/topBarLayout"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Notification Icon -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/imageNotificationCircle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/circleblue" />
            <ImageView
                android:id="@+id/imageNotification"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:layout_marginBottom="2sp"
                android:layout_marginLeft="-3sp"
                android:src="@drawable/notif" />
        </FrameLayout>

        <!-- Gift Icon -->
        <LinearLayout
            android:id="@+id/giftLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="16dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imageGiftCircle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/circleblue" />
                <ImageView
                    android:id="@+id/imageGift"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:src="@drawable/gift" />
            </FrameLayout>
            <TextView
                android:id="@+id/textTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1d 23h"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings Icon -->
        <FrameLayout
            android:id="@+id/settingsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/imageSettingsCircle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/circleblue" />
            <ImageView
                android:id="@+id/imageSettings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/setting" />
        </FrameLayout>
    </LinearLayout>

    <!-- HEADER CONTAINER (Avatar & Greeting) -->
    <FrameLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarLayout"
        app:layout_constraintWidth_percent="1.0">
        <ImageView
            android:id="@+id/imageAvatar"
            android:layout_width="320dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/character" />
        <FrameLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="25dp"
            android:layout_marginTop="45dp">
            <TextView
                android:id="@+id/textGreeting"
                android:layout_width="100sp"
                android:layout_height="70sp"
                android:text="User"
                android:gravity="center"
                android:background="@drawable/bubble"
                android:textColor="@color/BlckYellow"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <!-- SCROLLABLE CONTENT (wrapped in ScrollView) -->
    <ScrollView
        android:id="@+id/scrollViewMainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/scrollContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MAIN CONTENT SECTION WITH ROUNDED TOP -->
            <LinearLayout
                android:id="@+id/roundedTopContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bgblue"
                android:clipToOutline="true"
                android:padding="16dp">

                <!-- "My Badge" row -->
                <LinearLayout
                    android:id="@+id/linearBadgeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">
                    <TextView
                        android:id="@+id/textMyBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Badge"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/textSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold_italic"
                        android:text="See All"
                        android:layout_marginEnd="15sp"
                        android:layout_marginTop="-5sp"
                        android:textSize="18sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:textColor="@android:color/white"/>
                </LinearLayout>

                <!-- Horizontal ScrollView for Badges -->
                <HorizontalScrollView
                    android:id="@+id/badgeScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bgbrown"
                    android:clipToPadding="false">
                    <LinearLayout
                        android:id="@+id/linearBadgeContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">
                        <!-- Example Badges -->
                        <ImageView
                            android:layout_width="75dp"
                            android:layout_height="75dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ecogreen" />
                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ecoblue" />
                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ecobrown" />
                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ecogold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- "Activity log" Title -->
                <TextView
                    android:id="@+id/textActivityLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Activity log"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />

                <!-- Container for Month/Year arrows + day bubbles -->
                <LinearLayout
                    android:id="@+id/parentLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bgbrown"
                    android:padding="8dp">
                    <!-- Top Row: Left Arrow, Month/Year, Right Arrow -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">
                        <ImageButton
                            android:id="@+id/ivLeftArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/leftarrow"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="8dp" />
                        <TextView
                            android:id="@+id/tvMonthYear"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="March 2025"
                            android:textSize="18sp"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/ivRightArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/rightarrow"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="8dp" />
                    </LinearLayout>

                    <!-- Bottom Row: Day Bubbles -->
                    <LinearLayout
                        android:id="@+id/activityLogLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:weightSum="4">
                        <!-- 1) Selected Day Bubble -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="@drawable/bgcircle">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MON"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="03"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <!-- 2) Unselected Day Bubble -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="@drawable/bgcircle">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TUE"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="04"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <!-- 3) Unselected Day Bubble -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="@drawable/bgcircle">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WED"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="05"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <!-- 4) Unselected Day Bubble -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="@drawable/bgcircle">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="THU"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="06"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Selected Character Section (NO Shop button) -->
                    <LinearLayout
                        android:id="@+id/selectedCharacterContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"
                        android:padding="8dp">

                        <!-- Display the currently selected character -->
                        <ImageView
                            android:id="@+id/imageSelectedCharacter"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:scaleType="fitCenter"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/character" />

                        <!-- Display the selected character's name -->
                        <TextView
                            android:id="@+id/textSelectedCharacterName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Green Warrior"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:textColor="@android:color/white"/>

                        <!-- Label for unlocked characters -->
                        <TextView
                            android:id="@+id/textUnlockedCharactersLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Swipe to select from unlocked characters:"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:textColor="@android:color/white"/>

                        <!-- Horizontal RecyclerView for unlocked characters -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerUnlockedChars"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipToPadding="false"
                            android:paddingBottom="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM BUTTON (Optional) -->
    <Button
        android:id="@+id/bottomButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bottom Action"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
