<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SELECTED state: green circle behind icon -->
    <item android:state_checked="true">
        <layer-list>
            <!-- The green circle background -->
            <item
                android:width="48dp"
                android:height="48dp"
                android:gravity="center"
                android:drawable="@drawable/circle_green" />

            <!-- The actual icon, centered on top -->
            <item
                android:gravity="center"
                android:drawable="@drawable/home" />
        </layer-list>
    </item>

    <!-- UNSELECTED state: just the icon -->
    <item
        android:drawable="@drawable/home" />
</selector>
