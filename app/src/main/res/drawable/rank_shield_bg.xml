<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Solid green fill -->
    <solid android:color="#00FF11" /> <!-- Adjust green shade if you like -->

    <!-- Add black border -->
    <stroke
        android:width="2dp"
        android:color="#000000" />

    <!-- Slightly rounded corners to mimic a badge/shield shape -->
    <corners
        android:topLeftRadius="4dp"
        android:topRightRadius="4dp"
        android:bottomLeftRadius="8dp"
        android:bottomRightRadius="8dp" />

    <!-- Optional padding so the text isn’t right against the edges -->
    <padding
        android:left="6dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="2dp" />
</shape>
